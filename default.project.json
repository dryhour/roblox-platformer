{
  "name": "roblox-platformer",
  "tree": {
    "$className": "DataModel",
    "ReplicatedStorage": {
      "Shared": {
        "$path": "src/shared"
      },
      "Remotes": {
        "$className": "Folder",
        "SetReady": {
          "$className": "RemoteEvent"
        },
        "ChooseColor": {
          "$className": "RemoteEvent"
        },
        "ChangeSetting": {
          "$className": "RemoteEvent"
        },
        "FireBeam": {
          "$className": "RemoteEvent"
        },
        "Announce": {
          "$className": "RemoteEvent"
        }
      },
      "MatchState": {
        "$className": "Configuration"
      }
    },
    "ServerScriptService": {
      "Server": {
        "$path": "src/server"
      }
    },
    "ServerStorage": {
      "Maps": {
        "$path": "src/maps"
      }
    },
    "StarterPlayer": {
      "$properties": {
        "EnableMouseLockOption": false
      },
      "StarterPlayerScripts": {
        "Client": {
          "$path": "src/client"
        }
      },
      "StarterCharacter": {
        "$path": "src/character/StarterCharacter.model.json"
      }
    },
    "Workspace": {
      "$properties": {
        "FilteringEnabled": true,
        "Gravity": 110
      }
    },
    "Lighting": {
      "$properties": {
        "Ambient": [
          0,
          0,
          0
        ],
        "Brightness": 2,
        "GlobalShadows": true,
        "Outlines": false,
        "Technology": "Voxel"
      }
    },
    "SoundService": {
      "$properties": {
        "RespectFilteringEnabled": true
      }
    }
  }
}
