{
  "name": "brainrot-vs-brainrot",
  "tree": {
    "$className": "DataModel",
    "ReplicatedStorage": {
      "Shared": {
        "$path": "src/shared"
      },
      "Remotes": {
        "$className": "Folder",
        "Boost": {
          "$className": "RemoteEvent"
        },
        "Ability": {
          "$className": "RemoteEvent"
        },
        "Knockback": {
          "$className": "RemoteEvent"
        },
        "Effect": {
          "$className": "RemoteEvent"
        },
        "Announce": {
          "$className": "RemoteEvent"
        }
      },
      "MatchState": {
        "$className": "Configuration"
      }
    },
    "ServerScriptService": {
      "Server": {
        "$path": "src/server"
      }
    },
    "StarterPlayer": {
      "$properties": {
        "EnableMouseLockOption": false
      },
      "StarterPlayerScripts": {
        "Client": {
          "$path": "src/client"
        }
      }
    },
    "Workspace": {
      "$properties": {
        "FilteringEnabled": true,
        "Gravity": 150
      }
    },
    "Lighting": {
      "$properties": {
        "Ambient": [
          0.35,
          0.33,
          0.45
        ],
        "Brightness": 2,
        "GlobalShadows": true,
        "Outlines": false
      }
    },
    "SoundService": {
      "$properties": {
        "RespectFilteringEnabled": true
      }
    }
  }
}
